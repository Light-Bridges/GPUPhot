# gpuphot/.env.example
# Copy to .env and fill in the values for your environment.
# All variables are optional — services fall back to the defaults shown in docker-compose.yml.
# Keep credentials and secrets out of version control.

########################################
# 1) Runtime / logging
########################################
GPUPHOT_ENVIRONMENT=production          # production | development | profiler
GPUPHOT_DEBUG=False                     # True enables verbose internal logging
GPUPHOT_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR

########################################
# 2) Paths and data (adjust for host)
########################################
ASTROMETRY_CACHE_PATH=./astrometry_cache
IMAGE_PATH=~/gpuphot_images
INSTRUMENT_CONFIG_PATH=./gpuphot/instrument_configs
# PROCESSED_IMAGE_FOLDER=gpuphot_processed

# Path where PostgreSQL stores its data files.
# IMPORTANT: must be an absolute path OUTSIDE the project directory.
# PostgreSQL sets 700 permissions on this directory (owned by the postgres
# user inside the container), which prevents Docker from scanning it when
# building images if the path is inside the repo.  The default in
# docker-compose.yml places the data one level above the project root
# (../gpuphot_database) to avoid this conflict.  Override here with an
# absolute path if you need a specific location.
# POSTGRES_DATA_PATH=/home/$USER/gpuphot_database

########################################
# 3) Database
########################################
POSTGRES_HOST=postgres                  # docker service name; use hostname/IP for external
POSTGRES_PORT=5432                      # port for host-side / non-Docker connections (psql, standalone scripts).
                                         # Dockerized workers always use 5432 on the internal network regardless
                                         # of this value -- see POSTGRES_HOST_PORT below for their exposure.
POSTGRES_USER=admin
POSTGRES_PASSWORD=gpuphot

########################################
# 4) Log shipping (Logstash)
########################################
# Set LOGSTASH_LOGGING=True to forward structured logs from all workers.
# LOGSTASH_HOST defaults to the compose `logstash` service.
# Point to an external Logstash instance by overriding LOGSTASH_HOST.
LOGSTASH_LOGGING=False
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5000

########################################
# 5) Astrometry
########################################
GPUPHOT_ASTROMETRY_TIMEOUT=60          # seconds for local astrometry.net solver
GPUPHOT_ASTROMETRY_ONLINE_TIMEOUT=70   # seconds for nova.astrometry.net API
# ASTROMETRY_API_KEY=                  # required only for online solving

########################################
# 6) cuML crossmatch backend
########################################
# Adaptive mode: cuML is used only when detected source count is in [MIN, MAX].
# Both MIN and MAX must be set with MAX > MIN > 0 to enable adaptive mode.
# Set GPUPHOT_USE_CUML_CROSSMATCH=1 to force cuML for all crossmatches (testing only).
GPUPHOT_USE_CUML_CROSSMATCH=0
GPUPHOT_CUML_MIN_SOURCES=0
GPUPHOT_CUML_MAX_SOURCES=0

########################################
# 7) GPU / worker
########################################
GPU_ID=0
CELERY_CONCURRENCY=1
INSTRUMENT_NAME=default

# Path on the host where JupyterLab notebooks are stored and persisted.
# Defaults to ./notebooks (the example notebooks bundled with the repo).
# Set this to keep your own work outside the repository directory.
# NOTEBOOKS_PATH=/home/$USER/gpuphot_notebooks

########################################
# 8) Service ports (override if busy)
########################################
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379
LOGSTASH_PORT=5000
POSTGRES_HOST_PORT=5432                 # host port exposing the postgres container; change only if 5432 is
                                         # already taken on this machine. Does not affect the value above.
JUPYTER_PORT=8888
FLOWER_PORT=5555

########################################
# 9) Profiler-specific (debug profile only)
########################################
# PROFILER_SSSH_PORT=2222
# PROFILER_38_SSSH_PORT=2223
# PROFILER_JETSON_SSSH_PORT=2224
# PROFILER_JETSON_ORIN_SSSH_PORT=2225
# PROFILER_JETSON_SUPER_SSSH_PORT=2226
# PROFILER_JETSON_SUPER_38_SSSH_PORT=2228
# ROOT_PASSWORD=gpuphot_profiler

########################################
# 10) BLAS kernel (CPU reproducibility)
########################################
# OpenBLAS selects its kernel from the host CPU, and the kernels do not round
# identically.  Left free, two machines processing the same frame can disagree
# on the zero point, because the CPU clustering settles in a different local
# optimum.  Usually you do NOT need to set anything here: the compose files
# pin SkylakeX by default, and the images (sitecustomize.py) and the library
# itself (gpuphot/__init__.py, when imported before numpy) auto-select the
# right kernel from the CPU (AVX-512 -> SkylakeX, AVX2-only -> Haswell; both
# A/B-verified to give identical zero points).  See USAGE.md §6.0.
# Uncomment to OVERRIDE that choice for this machine (Haswell, Zen, ...),
# or to let OpenBLAS choose again with an empty value.
#
# CAUTION: the SkylakeX default needs AVX-512.  On a CPU without it (e.g. the
# i5-10400F in ttt1) OpenBLAS aborts with SIGILL (exit 132) with no output at
# all, which looks like the process simply vanished.  Those hosts MUST set
# OPENBLAS_CORETYPE=Haswell here.  `grep -c avx512f /proc/cpuinfo` returns 0
# on an affected host.  Images rebuilt with sitecustomize.py (repo root) also
# catch this at runtime and downgrade to Haswell with a stderr warning instead
# of dying, but pin it here anyway so the state is explicit.
#
# Outside Docker (gpuphot used as a library or git submodule) neither compose
# nor this file applies, so nothing pins the kernel.  For that case gpuphot
# itself logs a WARNING the first time the CPU star clustering runs with the
# variable unset (gpuphot/phot/psf.py), naming the kernel the host picked.
# Export OPENBLAS_CORETYPE in the environment that launches Python to fix it;
# setting it after Python has imported numpy has no effect.
# OPENBLAS_CORETYPE=SkylakeX
#
# The Jetson (aarch64) profilers ignore the value above: those kernel names are
# x86-64 only.  They run unpinned unless you set an aarch64 kernel here
# (CORTEXA57, NEOVERSEN1, ARMV8).  Untested so far, the ARM hosts were never
# part of the divergence we measured.
# OPENBLAS_CORETYPE_ARM=
