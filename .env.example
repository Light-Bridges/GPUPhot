# gpuphot/.env.example for GPUPhot service
# Copy to gpuphot/.env and edit values for local configuration and testing.

########################################
# 1) General library settings
########################################
GPUPHOT_DEBUG=True
GPUPHOT_LOG_LEVEL=DEBUG
GPUPHOT_ENVIRONMENT=development
# Optionally restrict GPU id used by gpuphot
# GPUPHOT_GPU_ID=0

########################################
# 2) Paths and data (adjust for host)
########################################
# Local path for astrometry cache
ASTROMETRY_CACHE_PATH=/path/to/astrometry_cache
# Path where images will be read/written
IMAGE_BASE_PATH=/path/to/images
INSTRUMENT_CONFIG_PATH=/path/to/cameras_config

########################################
# 3) Database and services
########################################
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gpuphot
POSTGRES_PASSWORD=gpuphot

########################################
# 4) External integrations / monitoring
########################################
LOGSTASH_LOGGING=True
LOGSTASH_HOST=logstash.example.com
LOGSTASH_PORT=5000

########################################
# 5) Testing / profiling
########################################
PROFILER_SSH_PORT=2223

# Notes:
# - Keep credentials and secrets out of git. Use this file as an example only.
# - Values here are placeholders to document expected variables.
