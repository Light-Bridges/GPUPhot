# Library settings
GPUPHOT_DEBUG=True
GPUPHOT_LOG_LEVEL=DEBUG
GPUPHOT_ENVIRONMENT=nvtx

#GPU_ID=2

# Astrometry settings
ASTROMETRY_CACHE_PATH=/mnt/vast/cache/astrometry
# Increase timeout for Orin NX ARM64 CPU (default 60s is too short for difficult comet fields)
GPUPHOT_ASTROMETRY_TIMEOUT=300

# Worker settings
INSTRUMENT_NAME=default
INSTRUMENT_CONFIG_PATH=/mnt/vast/samueltest/gpuphot/cameras_config
IMAGE_PATH=/mnt/vast/samueltest


# Logging settings
LOGSTASH_LOGGING=True
LOGSTASH_HOST=10.0.210.30
LOGSTASH_PORT=5000

# Database settings
POSTGRES_PASSWORD=gpuphot

# Local Testing
#IMAGE_BASE_PATH=/mnt/vast/samueltest
#INSTRUMENT_CONFIG_BASE_PATH=/mnt/vast/samueltest/gpuphot/cameras_config

POSTGRES_HOST=nostore
POSTGRES_PORT=5432

PROFILER_SSSH_PORT=2223
PROFILER_RESULTS_PATH=/mnt/vast/samueltest/gpuphot/profiling_results

BASE_IMAGE=nvcr.io/nvidia/l4t-ml:r36.2.0-py3
#BASE_IMAGE=nvcr.io/nvidia/l4t-cuda:11.4.19-runtime
#NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
REQUIREMENTS_FILE=requirements_jetson_orin_36.txt
