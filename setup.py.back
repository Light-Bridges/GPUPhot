from pipreqs.pipreqs import parse_requirements
from setuptools import setup, find_packages

# parse_requirements() returns generator of pip.req.InstallRequirement objects
install_reqs = parse_requirements('requirements.txt')
# reqs is a list of requirement
reqs = [str(ir['name']) + '==' + str(ir['version']) for ir in install_reqs]

setup(
    name='GPUPhot',
    version='0.0',
    packages=find_packages(),  # ['tests', 'gpuphot'],
    url='https://lightbridges.es/',
    license='',
    author='Samuel Lemes Perera',
    author_email='Samuel@lightbridges.es',
    description='GPU photometry library',
    install_requires=reqs,
    package_data={'gpu_phot': ['resources/gpu_phot.fits.gz']},
    setup_requires=['pytest-runner'],
    tests_require=['pytest'],
)
